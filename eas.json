{
	"cli": {
		"version": ">= 14.2.0",
		"appVersionSource": "remote"
	},
	"build": {
		"production": {
			"autoIncrement": true
		},
		"production-apk": {
			"android": {
				"buildType": "apk"
			},
			"env": {
				"APP_VARIANT":"production"
			}
		},
		"preview": {
			"extends": "production",
			"distribution": "internal"
		},
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"env": {
				"APP_VARIANT":"development"
			}
		}
	},
	"submit": {
		"production": {}
	}
}

